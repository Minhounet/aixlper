{
  "cleanupPeriodDays": 14,
  "env": {
@@ENV_BLOCK@@
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(mvn:*)",
      "Bash(mvnd:*)",
      "Bash(./mvnw:*)",
      "Bash(./gradlew:*)",
      "Bash(make:*)",
      "Bash(command -v:*)",
      "Bash(which:*)",
      "Bash(ls)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(cut:*)",
      "Bash(basename:*)",
      "Bash(dirname:*)",
      "Bash(stat:*)",
      "Bash(file:*)",
      "Bash(date:*)",
      "Bash(diff:*)",
      "Bash(jq:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git merge-base:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(grep:*)",
      "Bash(cat:*)",
      "Bash(curl:*)",
      "Bash(mkdir:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(**/*.pem)"
    ],
    "defaultMode": "acceptEdits",
    "additionalDirectories": [
      "~/.claude/skills"
    ]
  },
  "model": "opus[1m]",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/litellm-budget.py\" --hook",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "python3 \"$HOME/.claude/litellm-budget.py\" --statusline",
    "refreshInterval": 60
  },
  "syntaxHighlightingDisabled": true,
  "tui": "fullscreen",
  "theme": "dark"
}
