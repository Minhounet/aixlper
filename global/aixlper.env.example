# Machine-local Claude environment. Copy to ~/.claude/aixlper.env, fill in,
# then run scripts/install-global.sh to regenerate ~/.claude/settings.json.
#
#   cp global/aixlper.env.example ~/.claude/aixlper.env
#   chmod 600 ~/.claude/aixlper.env
#
# NEVER commit the filled-in file - it holds a live credential.
# Leave a value empty and it is simply omitted from the generated settings.
# On a personal machine with no corporate gateway, leave ALL of them empty.

# Custom API gateway. Omit to use Anthropic's default endpoint.
ANTHROPIC_BASE_URL=

# Token for the gateway above. Omit when using a normal Claude login.
ANTHROPIC_AUTH_TOKEN=

# Corporate proxy. Written as both upper- and lowercase in the settings,
# since different tools read different casing.
HTTP_PROXY=

# Hosts that must bypass the proxy. Comma-separated.
NO_PROXY=
